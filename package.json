{
  "name": "screen-advait-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Desktop Screenshot Management & License Management Platform",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --recursive --parallel run dev",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm build && pnpm --recursive run test:unit",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
