{
  "name": "screenadvait-desktop",
  "version": "1.1.0",
  "description": "ScreenAdvait enterprise desktop capture client",
  "author": "ScreenAdvait",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/main/main.js && esbuild src/preload/preload.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/preload.js",
    "build": "pnpm build:main && vite build",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json && tsc --noEmit --incremental false -p tsconfig.renderer.json",
    "build:electron": "pnpm build && electron-builder --win -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "clsx": "^2.1.1",
    "form-data": "^4.0.0",
    "lucide-react": "^0.439.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.7.0",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.screenadvait.desktop",
    "productName": "ScreenAdvait Enterprise Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "publisherName": "ScreenAdvait Enterprise",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScreenAdvait Enterprise",
      "include": "build/installer.nsh"
    }
  }
}
