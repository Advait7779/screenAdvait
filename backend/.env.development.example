NODE_ENV=development
PORT=5000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/screenadvait_db
JWT_SECRET=generate-a-random-development-secret-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-development-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY=false
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=G:/My Drive/ScreenAdvait Screenshots
SCREENSHOT_RETENTION_DAYS=15

# Optional local demo data. Both passwords must contain at least 12 characters.
AUTO_SEED=false
# These credentials are applied only by the explicit superadmin:provision command,
# or when AUTO_SEED=true for a demo environment.
SUPERADMIN_EMAIL=superadmin@system.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_FULL_NAME=Super Administrator
SUPERADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
SEED_DEMO_LICENSE_KEY=
