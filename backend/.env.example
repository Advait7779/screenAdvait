NODE_ENV=production
PORT=5000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/screenadvait_db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
CORS_ORIGINS=https://screenadvait.example.com
TRUST_PROXY=false
LOCAL_STORAGE_PATH=./storage
STORAGE_PROVIDER=local

# Optional direct Google Drive API storage. Leave these empty to use
# LOCAL_STORAGE_PATH with Google Drive for Desktop.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/v1/storage/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=ScreenAdvait Screenshots
SCREENSHOT_RETENTION_DAYS=15

# SMTP & Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@advaitteleservices.com
SMTP_PASS=
SMTP_FROM=support@advaitteleservices.com
NOTIFY_EMAIL=sales@advaitteleservices.com
LEAD_RATE_LIMIT_PER_15_MIN=20
API_RATE_LIMIT_PER_15_MIN=3000
ADMIN_RATE_LIMIT_PER_15_MIN=300
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_CONNECTION=100
